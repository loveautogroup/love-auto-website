{
  // Cloudflare Pages configuration for Love Auto Group.
  //
  // This file binds the KV namespace used by the merchandising admin
  // (Jordan's featuring + overlay controls). The actual KV namespace ID
  // is set in the Cloudflare Pages dashboard under Settings → Functions →
  // KV namespace bindings. Use the same binding name here ("MERCHANDISING")
  // for local dev parity.
  //
  // To create the KV namespace (one-time, via Cloudflare dashboard or CLI):
  //   wrangler kv:namespace create MERCHANDISING
  //   wrangler kv:namespace create MERCHANDISING --preview
  //
  // Then paste the returned IDs below (or configure via dashboard).

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "love-auto-website",
  "pages_build_output_dir": "out",

  "kv_namespaces": [
    {
      "binding": "MERCHANDISING",
      "id": "fb1d2c022f45486ba77fd5ba0ab04b3a",
      "preview_id": "8cc9677f116a4f0aaa29826e1a27dcb8"
    },
    {
      // Finance-application leads from the public /financing form.
      "binding": "LEADS",
      "id": "f0cd98ac82a24502a8d454420e56a497",
      "preview_id": "e111ee4ce8f3446082e15efe99ca9ee8"
    },
    {
      // Created via Cloudflare dashboard Apr 24 2026.
      //
      // KEEP THIS BINDING. Its original purpose (the `inventory:current`
      // snapshot + `inventory:log:*` written by the inventory-sync Cron
      // Worker) was RETIRED 2026-08-03 along with workers/inventory-sync,
      // but the namespace is still live and still needed:
      //   - /api/vehicle-views stores its `views:{path}` analytics cache here
      //   - workers/kv-snapshot backs this namespace up to R2 nightly
      // Nothing reads `inventory:current` / `inventory:log:*` any more:
      // /api/admin/sync-status was repointed 2026-08-03 at the pipeline that
      // actually runs (build snapshot + /api/inventory + the feeds) and no
      // longer touches this namespace. Those frozen keys are dead weight and
      // can be deleted whenever convenient.
      "binding": "INVENTORY",
      "id": "8e64e40dfeae483396a3b1eaa755c820",
      "preview_id": "9cefd2c111df4fb78e80090ade013440"
    }
  ],

  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"]
}
