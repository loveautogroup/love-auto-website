{
  // Type-checking for the Cloudflare edge code — Pages Functions and Workers.
  //
  // WHY A SECOND CONFIG. The main tsconfig.json EXCLUDES `functions` and
  // `workers`, so `tsc --noEmit` and `next build` never looked at them. That is
  // not an oversight to simply delete: this code runs in the Workers runtime,
  // not the browser or Node, and pulling it into the Next.js program would type
  // it against DOM/Next globals it does not have and lose the ones it does
  // (Env bindings, KVNamespace, the `cf` fetch option).
  //
  // The cost of having no check at all was four real bugs in one afternoon
  // (2026-08-25), every one of which tsc would have caught instantly:
  //   * a block spliced into the wrong function
  //   * `v.price` where the field is `retailPrice`
  //   * `photos` treated as string[] when they are {url,isPrimary} objects
  //   * a bare slug handed to escapeUrl, which only accepts root-relative
  // They were found by rendering the page by hand. That is not a check.
  //
  // Run: npm run typecheck:functions   (also runs in prebuild)
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Workers runtime, not the browser: no DOM lib, and the Cloudflare globals
    // instead. This is the whole reason the files cannot join the main program.
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    // The main config's Next plugin and incremental cache are irrelevant here
    // and the plugin errors without a Next program.
    "plugins": [],
    "incremental": false
  },
  // SCOPE: Pages Functions and the code they share -- NOT `workers/`.
  //
  // Each worker under workers/ is its OWN project: own package.json, own
  // node_modules, own tsconfig. Including them here typechecks their source
  // against the WEBSITE's installed dependencies, which do not contain theirs.
  // That passes locally (the nested node_modules exists on a dev machine) and
  // fails on Cloudflare, which only runs `npm ci` at the repo root:
  //
  //   workers/turso-snapshot/src/index.ts(30,60): error TS2307:
  //     Cannot find module '@libsql/client/web'
  //
  // Because this config runs in `prebuild`, that error took the whole site
  // build down -- production sat on a 16-hour-old deployment while six pushes
  // silently failed (2026-08-27). A check that only passes on one machine is
  // worse than no check.
  //
  // Each worker is typechecked by its own tsconfig, from its own directory.
  "include": ["functions/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", ".next", "out", "workers"]
}
